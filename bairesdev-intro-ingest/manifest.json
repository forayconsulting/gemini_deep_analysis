{
  "manifest_version": 3,
  "name": "BairesDev Intro Ingest",
  "version": "1.0.0",
  "description": "Scrapes introduction data from BairesDev referrals portal and sends to n8n for processing",
  "permissions": [
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://handlers-referralsportal.bairesdev.com/*",
    "https://www.linkedin.com/*",
    "https://bairesdevsales.app.n8n.cloud/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://handlers-referralsportal.bairesdev.com/intros*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
