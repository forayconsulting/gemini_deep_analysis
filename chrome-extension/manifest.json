{
  "manifest_version": 3,
  "name": "Gemini Assistant",
  "version": "1.0.0",
  "description": "A Chrome extension that calls Gemini API",

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ]
}